# PrintLab — copie ce fichier en « .env » à côté de docker-compose.yml, puis remplis-le.
# Ne le publie jamais : il contient tes secrets.

# --- Obligatoire -------------------------------------------------------------
# Mot de passe de l'interface web (choisis-en un long).
APP_PASSWORD=change-moi

# --- Recommandé --------------------------------------------------------------
# Clé de signature des sessions. Laisse vide pour qu'une clé aléatoire soit créée
# au premier lancement et gardée dans le dossier de données (data/secret_key).
SECRET_KEY=

# Jeton pour l'API (scripts, Home Assistant…) : en-tête « Authorization: Bearer <jeton> ».
# Génère-en un avec :  openssl rand -hex 32
API_TOKEN=

# --- Imprimante (facultatif) -------------------------------------------------
# Adresse de Moonraker. Tu peux aussi la saisir dans Paramètres (prioritaire).
# MOONRAKER_URL=http://192.168.1.50:7125
# Clé API de Moonraker, seulement si ton Moonraker en exige une.
# MOONRAKER_API_KEY=

# --- Import depuis Spoolman (facultatif, une seule fois) ----------------------
# SPOOLMAN_URL=http://192.168.1.10:7912

# --- Alertes et coût électrique via Home Assistant (facultatif) ---------------
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=            # jeton longue durée (profil HA > Sécurité)

# --- Recherche Thingiverse (facultatif) ---------------------------------------
# Jeton d'application gratuit : https://www.thingiverse.com/developers
# THINGIVERSE_TOKEN=

# --- Derrière un reverse proxy (Traefik, Nginx, Caddy…) ------------------------
# Adresses dont PrintLab accepte les en-têtes X-Forwarded-* (par défaut : 127.0.0.1).
# Mets l'IP de ton proxy, ou "*" si seul le proxy peut joindre PrintLab.
# FORWARDED_ALLOW_IPS=*

# --- Slicer (facultatif) ------------------------------------------------------
# Profil d'imprimante proposé par défaut dans le Slicer (nom exact d'un profil OrcaSlicer).
# DEFAULT_MACHINE=Qidi X-Max 4 0.4 nozzle
# Découpes simultanées et délai maximal d'une découpe (secondes).
# SLICE_CONCURRENCY=2
# SLICE_TIMEOUT=1800

# Fuseau horaire
TZ=Europe/Paris
